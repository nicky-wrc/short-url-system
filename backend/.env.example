# Copy to backend/.env for local use. Never commit .env.
DATABASE_URL=postgresql://shorturl:local-development-only@localhost:5432/shorturl
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
# Generate a unique random secret (at least 32 characters); never commit its real value.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SESSION_TTL_HOURS=8
# Browser origin allowed for writes. For Vite dev set http://localhost:5173.
# AUTH_ORIGIN=http://localhost:3000
# Set 1 only when deployed behind ONE trusted reverse proxy; local default is 0.
TRUST_PROXY_HOPS=0
# For providers requiring TLS, set true. Certificate verification stays enabled.
DATABASE_SSL=false
# Optional CA from your database provider, relative to backend/ or an absolute path.
# DATABASE_SSL_CA_FILE=certs/supabase-ca.crt
# Required only for destructive integration tests; use a dedicated empty database.
TEST_DATABASE_URL=postgresql://shorturl:local-development-only@localhost:5432/shorturl_test
TEST_DATABASE_SSL=false
# Set true only after confirming the local _test database is disposable.
TEST_DATABASE_RESET=false

# AI assistant (optional). Server-only key; NEVER use a VITE_ variable or commit a real key.
# Obtain an API key from https://platform.openai.com/api-keys and configure API billing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
